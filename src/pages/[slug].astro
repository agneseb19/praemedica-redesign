---
/**
 * Template unico per specializzazioni, esami di Alta Diagnostica, Radiologia, Fisioterapia,
 * Palestra riabilitativa e articoli. Contenuti 1:1 dal sito originale, nello schema della home:
 * apertura fotografica, sezioni numerate con intestazione centrata, banda finale per prenotare.
 */
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Blocks from '../components/Blocks.astro';
import TeamCards from '../components/TeamCards.astro';
import SpecList from '../components/SpecList.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import BookBand from '../components/BookBand.astro';
import { allPages, toArticle, summaryOf, stripTags, type Page } from '../lib/content';
import { specializzazioniMenu, altaDiagnostica } from '../data/site';
import Icon from '../components/Icon.astro';
import { machines, otherExams } from '../lib/machines';

export function getStaticPaths() {
  const CUSTOM = new Set(['home', 'chi-siamo', 'medici', 'convenzioni', 'contatti', 'mammografia-in-tomosintesi', 'ortopanoramica', 'radiologia']);
  return allPages().filter((p) => !CUSTOM.has(p.slug)).map((p) => ({ params: { slug: p.slug }, props: { page: p } }));
}

const { page } = Astro.props as { page: Page };
const a = toArticle(page);
const href = `/${page.slug}/`;
const isPost = page.type === 'post';
const isDiag = altaDiagnostica.some((x) => x.href === href) || page.slug === 'radiologia';
const parent = isPost ? { label: 'Approfondimenti' } : isDiag ? { label: 'Alta Diagnostica', href: '/alta-diagnostica/' } : { label: 'Specializzazioni', href: '/specializzazioni/' };
const longTitle = a.title !== page.title && a.title.length > page.title.length;
const h1 = longTitle ? page.title : a.titleHtml;
const [hero1, hero2] = a.heroImages;
const [introFirst, ...introRest] = a.intro as any[];
const firstText = introFirst ? stripTags(introFirst.html) : '';
const firstSentence = (firstText.match(/^.+?[.!?](?=\s|$)/)?.[0] ?? '').trim();
/* nell'intestazione solo il primo paragrafo; il resto nella colonna di lettura */
const introParas = introFirst ? (introFirst.html.match(/<p[\s\S]*?<\/p>/g) ?? [introFirst.html]) : [];
const introLead = (introParas[0] ?? '').replace(/^<p[^>]*>|<\/p>$/g, '');
const introMore = [...introParas.slice(1), ...introRest.map((b: any) => b.html)].join('\n');
const pad = (n: number) => String(n).padStart(2, '0');
let n = introFirst ? 1 : 0;

const pool = [...specializzazioniMenu, ...altaDiagnostica].filter((x) => x.href !== href && x.href !== '/tac/') as { label: string; href: string }[];
const start = Math.max(0, specializzazioniMenu.findIndex((x) => x.href === href));
const related = [...pool.slice(start), ...pool.slice(0, start)].slice(0, 4).map((x) => summaryOf(x.href, x.label));

/* ---------- pagine di alta diagnostica: apertura propria per ogni esame, servizi prima del testo ---------- */
const DIAG_HERO: Record<string, 'split' | 'photo'> = {
  '/densitometria-ossea/': 'split', '/radiologia/': 'photo',
};
const machine = machines.find((m) => m.href === href);
const services = a.sections.filter((s) => s.kind === 'services');
const team = a.sections.filter((s) => s.kind === 'team');
const reading = a.sections.filter((s) => s.kind === 'default');
const topics = [{ title: 'In breve' }, ...reading.map((r) => ({ title: r.titleHtml || 'Approfondimento' }))];
const others = otherExams(href);
---
<Base title={page.seo?.title ?? stripTags(h1)} description={page.seo?.description}>
  {isDiag ? (
    <>
      <PageHero
        crumbs={[{ label: 'Home', href: '/' }, parent, { label: stripTags(page.title) }]}
        title={h1}
        lead={longTitle ? a.titleHtml : firstSentence || undefined}
        img={hero1?.src} alt={hero1?.alt}
        variant={DIAG_HERO[href] ?? 'photo'}
      >
        {machine && (
          <ul class="dfacts" role="list" slot="extra">{machine.spec.map(([k, v]) => <li><small>{k}</small><span>{v}</span></li>)}</ul>
        )}
      </PageHero>

      {services.map((sv, i) => (
        <section id={sv.id} class="sec sx--services">
          <SectionHead n={pad(i + 1)} title={sv.titleHtml} desc={i === 0 ? firstSentence || undefined : undefined} />
          <div class="wrap sx__body"><Blocks blocks={sv.blocks} /></div>
        </section>
      ))}

      {team.map((t, i) => (
        <section id={t.id} class="sec sx--team">
          <SectionHead n={pad(services.length + i + 1)} title={t.titleHtml} />
          <div class="wrap sx__body">{t.people ? <TeamCards people={t.people} /> : <Blocks blocks={t.blocks} />}</div>
        </section>
      ))}

      <section class="sec" aria-labelledby="sapere-t">
        <SectionHead n={pad(services.length + team.length + 1)} id="sapere-t" title="Da sapere" desc="Le informazioni sull'esame, divise per argomento. Scegli quello che ti interessa." />
        <div class="wrap ds" data-switch data-switch-click>
          <ol class="ds__nav" role="list" aria-label="Argomenti">
            {topics.map((tp, i) => (
              <li><button type="button" class:list={['ds__btn', { 'is-on': i === 0 }]} data-switch-btn={String(i)} aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`ds-${i}`}>
                <span class="ds__n">{pad(i + 1)}</span><span class="ds__t" set:html={tp.title} /><Icon name="arrow-right" />
              </button></li>
            ))}
          </ol>
          <div class="ds__panes">
            <article id="ds-0" class="ds__pane is-on" data-switch-pane="0">
              <p class="ds__k">01</p>
              <h3 class="ds__h">In breve</h3>
              {introLead && <p class="ds__lead" set:html={introLead} />}
              {hero2 && (
                <div class="ds__pics">
                  {hero2 && <figure class="ds__pic"><Img src={hero2.src} alt={hero2.alt} sizes="(min-width: 900px) 420px, 92vw" widths={[500, 900]} /></figure>}
                </div>
              )}
              {introMore && <div class="prose ds__body" set:html={introMore} />}
            </article>
            {reading.map((r, i) => (
              <article id={`ds-${i + 1}`} class="ds__pane" data-switch-pane={String(i + 1)}>
                <p class="ds__k">{pad(i + 2)}</p>
                <h3 class="ds__h" id={r.id} set:html={r.titleHtml || 'Approfondimento'} />
                <div class="ds__body"><Blocks blocks={r.blocks} /></div>
              </article>
            ))}
          </div>
        </div>
        <script>
          /* dopo la scelta di un argomento, se il testo non è in vista (telefono) ci si porta lì */
          document.querySelectorAll<HTMLElement>('.ds').forEach((ds) => {
            ds.querySelectorAll<HTMLElement>('[data-switch-btn]').forEach((b) => b.addEventListener('click', () => {
              const pane = ds.querySelector<HTMLElement>(`[data-switch-pane="${b.dataset.switchBtn}"]`);
              if (!pane) return;
              const top = pane.getBoundingClientRect().top;
              if (top < 80 || top > innerHeight * 0.6) {
                const y = top + scrollY - 100;
                const lenis = (window as any).__lenis;
                lenis ? lenis.scrollTo(y) : scrollTo({ top: y, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
              }
            }));
          });
        </script>
      </section>

      <section class="sec" aria-labelledby="rel-title">
        <SectionHead n={pad(services.length + team.length + 2)} id="rel-title" title="Altri esami" desc="Gli altri esami di alta diagnostica del centro." />
        <div class="wrap">
          <div class="rel-exams"><SpecList items={others} variant="photos" /></div>
          <p class="rel__all" data-reveal><a class="btn btn--line" href="/alta-diagnostica/">Tutta l'alta diagnostica</a></p>
        </div>
      </section>
    </>
  ) : (
    <>
      <PageHero
        crumbs={[{ label: 'Home', href: '/' }, parent, { label: stripTags(page.title) }]}
        title={h1}
        lead={longTitle ? a.titleHtml : firstSentence || undefined}
        img={hero1?.src} alt={hero1?.alt}
      />

      {introFirst && (
        <section class="sec" aria-labelledby="in-breve">
          <SectionHead n="01" id="in-breve" title="In breve" desc={introLead} />
          {introMore && <div class="col"><div class="prose" data-reveal set:html={introMore} /></div>}
          {hero2 && <figure class="wide-pic" data-img><Img src={hero2.src} alt={hero2.alt} sizes="(min-width: 1100px) 1100px, 92vw" widths={[800, 1100, 1600]} /></figure>}
        </section>
      )}

      {a.sections.map((s) => {
        n += 1;
        const wide = s.kind === 'team' || s.kind === 'services';
        return (
          <section id={s.id} class:list={['sec', `sx--${s.kind}`]}>
            {s.title ? <SectionHead n={pad(n)} title={s.titleHtml} /> : null}
            <div class:list={[wide ? 'wrap' : 'col', 'sx__body']}>
              {s.kind === 'team' && s.people ? <TeamCards people={s.people} /> : <Blocks blocks={s.blocks} />}
            </div>
          </section>
        );
      })}

      <section class="sec" aria-labelledby="rel-title">
        <SectionHead n={pad(n + 1)} id="rel-title" title="Altre specializzazioni" desc="Scopri le altre aree specialistiche del centro." />
        <div class="wrap">
          <SpecList items={related} variant="photos" />
          <p class="rel__all" data-reveal><a class="btn btn--line" href="/specializzazioni/">Tutte le specializzazioni</a></p>
        </div>
      </section>
    </>
  )}

  <BookBand />
</Base>

<style>
  .rel-exams :global(.ph) { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 760px) { .rel-exams :global(.ph) { grid-template-columns: 1fr; } }
  .rel__all { display: flex; justify-content: center; margin-top: clamp(2rem, 3vw, 3rem); }

  /* dati tecnici nell'apertura degli esami */
  .dfacts { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 1.2rem; width: 100%; margin-top: 1.2rem; border-top: 1px solid var(--line-2); }
  .dfacts li { display: grid; gap: 0.2rem; padding-top: 0.9rem; }
  .dfacts small { font-size: 0.78rem; color: var(--muted); }
  .dfacts span { font-size: 0.95rem; font-weight: 500; line-height: 1.35; color: var(--deep); }
  :global(.ph--dark) .dfacts, :global(.ph--photo) .dfacts { border-color: rgb(255 255 255 / 0.2); }
  :global(.ph--dark) .dfacts small, :global(.ph--photo) .dfacts small { color: rgb(255 255 255 / 0.7); }
  :global(.ph--dark) .dfacts span, :global(.ph--photo) .dfacts span { color: #fff; }

  /* "Da sapere": indice degli argomenti a sinistra, un argomento alla volta a destra */
  .ds { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 4rem); align-items: start; }
  .ds__nav { position: sticky; top: 110px; list-style: none; display: grid; gap: 0.5rem; }
  .ds__btn { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; align-items: center; gap: 1rem; width: 100%; min-height: 64px; padding: 1rem 1.2rem; background: var(--ice); border: 0; border-radius: 16px; font: inherit; text-align: left; color: var(--deep); cursor: pointer; transition: background-color 0.3s, color 0.3s; }
  .ds__btn:hover { background: var(--azure); }
  .ds__btn.is-on { background: var(--deep); color: #fff; }
  .ds__n { font-size: 0.85rem; font-variant-numeric: tabular-nums; color: var(--green); }
  .ds__btn.is-on .ds__n { color: #8fd69a; }
  .ds__t { font-size: 1.05rem; font-weight: 500; line-height: 1.35; letter-spacing: -0.015em; }
  .ds__btn :global(.icon) { width: 1.1rem; height: 1.1rem; opacity: 0; transform: translateX(-6px); transition: opacity 0.3s, transform 0.4s var(--ease); }
  .ds__btn.is-on :global(.icon) { opacity: 1; transform: none; }

  .ds__pane { display: none; padding: clamp(1.6rem, 3vw, 2.8rem); background: #fff; border: 1px solid var(--azure); border-radius: var(--r); }
  .ds__pane.is-on { display: block; animation: ds-in 0.5s var(--ease); }
  @keyframes ds-in { from { opacity: 0; transform: translateY(10px); } }
  .ds__k { font-size: 0.85rem; font-variant-numeric: tabular-nums; color: var(--green); }
  .ds__h { margin-top: 0.4rem; font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.3rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; color: var(--deep); }
  .ds__lead { margin-top: 1.2rem; font-size: 1.15rem; line-height: 1.6; color: var(--deep); }
  .ds__body { margin-top: 1.4rem; font-size: 1.02rem; line-height: 1.7; color: var(--ink-2); }
  .ds__body > :global(* + *) { margin-top: 1rem; }
  .ds__pics { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 0.8rem; margin-top: 1.6rem; }
  .ds__pic { margin: 0; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 16px; }
  .ds__pic:only-child { aspect-ratio: 16 / 9; }
  .ds__pic :global(picture), .ds__pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  @media (max-width: 900px) {
    .ds { grid-template-columns: 1fr; }
    .ds__nav { position: static; }
  }
  @media (prefers-reduced-motion: reduce) { .ds__pane.is-on { animation: none; } }
  @media (max-width: 640px) { .dfacts { grid-template-columns: 1fr; } }
</style>
