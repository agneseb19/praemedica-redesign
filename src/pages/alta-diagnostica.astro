---
/** Alta Diagnostica: gli esami con testi e foto originali, nello schema della home. */
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import BookBand from '../components/BookBand.astro';
import Icon from '../components/Icon.astro';
import { Picture } from 'astro:assets';
import { machines } from '../lib/machines';
import { getPage, stripTags, type Block } from '../lib/content';

const home = getPage('home');
const [heroSlider] = home.blocks.filter((b) => b.type === 'slides') as Extract<Block, { type: 'slides' }>[];
const diagText = (home.blocks.filter((b) => b.type === 'text') as Extract<Block, { type: 'text' }>[])[1];
const claim = stripTags((home.blocks.find((b) => b.type === 'heading' && /^Alta Diagnostica/.test((b as any).html)) as any).html);
const tac = heroSlider.slides[0];
---
<Base title="Alta Diagnostica" description={claim}>
  <PageHero crumbs={[{ label: 'Home', href: '/' }, { label: 'Alta Diagnostica' }]} eyebrow={tac.heading} title={claim} img={tac.bg} alt={tac.alt} />

  <section class="sec" aria-labelledby="intro-t">
    <SectionHead n="01" id="intro-t" title="Esami diagnostici di alta qualità" desc="Tecnologie avanzate e di ultima generazione, per risultati precisi e tempestivi." />
    <div class="col"><div class="prose" data-reveal set:html={diagText.html} /></div>
  </section>

  <!-- 02: mosaico degli esami, la TAC in grande -->
  <section class="sec" aria-labelledby="esami-t">
    <SectionHead n="02" id="esami-t" title="Gli esami" desc="Scegli l'esame per conoscere come funziona, quando è indicato e come prenotarlo." />
    <ul class="wrap bento" role="list">
      {machines.map((m, i) => (
        <li class:list={['tile', { 'tile--wide': i === 0 }]} data-reveal>
          <a href={m.href}>
            <span class:list={['tile__fig', { 'tile__fig--cut': m.href === '/densitometria-ossea/' }]}><Picture src={m.img} alt={m.alt} formats={['webp']} widths={[500, 900, Math.min(1400, m.img.width)]} sizes={i === 0 ? '(min-width: 900px) 40vw, 92vw' : '(min-width: 900px) 28vw, 92vw'} /></span>
            <span class="tile__body">
              <span class="tile__dev">{m.device}</span>
              <span class="tile__t">{m.exam}</span>
              {i === 0
                ? <span class="tile__spec">{m.spec.map(([k, v]) => <span><small>{k}</small>{v}</span>)}</span>
                : <span class="tile__s">{m.spec[0][1]}</span>}
              <span class="tile__more">Scopri l'esame <Icon name="arrow-right" /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <BookBand />
</Base>

<style>
  .bento { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(0.9rem, 1.5vw, 1.25rem); }
  .tile a { display: flex; flex-direction: column; height: 100%; padding: clamp(0.9rem, 1.2vw, 1.1rem); background: var(--ice); border-radius: var(--r); text-decoration: none; transition: background-color 0.4s, transform 0.5s var(--ease); }
  .tile a:hover { background: #e6eff1; transform: translateY(-3px); }
  .tile__fig { position: relative; display: block; height: clamp(200px, 22vw, 270px); overflow: hidden; background: #fff; border-radius: 16px; }
  .tile__fig :global(picture) { display: contents; }
  .tile__fig :global(img) { position: absolute; inset: 1.4rem; width: calc(100% - 2.8rem); height: calc(100% - 2.8rem); object-fit: contain; transition: transform 1s var(--ease); }
  .tile a:hover .tile__fig :global(img) { transform: scale(1.04); }
  /* foto originale già tagliata ai bordi: i lati tagliati sfumano nel bianco */
  .tile__fig--cut :global(img) { -webkit-mask-image: linear-gradient(90deg, #000 70%, transparent 98%), linear-gradient(0deg, transparent 0, #000 22%); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, #000 70%, transparent 98%), linear-gradient(0deg, transparent 0, #000 22%); mask-composite: intersect; }
  .tile__body { display: grid; gap: 0.35rem; justify-items: start; padding: 1.3rem 0.6rem 0.5rem; }
  .tile__dev { font-size: 0.8rem; color: var(--muted); }
  .tile__t { font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.7rem); font-weight: 500; line-height: 1.1; letter-spacing: -0.035em; color: var(--deep); }
  .tile__s { font-size: 0.92rem; color: var(--ink-2); }
  .tile__more { display: inline-flex; align-items: center; gap: 0.45rem; margin-top: 0.8rem; padding-bottom: 0.15rem; border-bottom: 1px solid currentColor; font-size: 0.92rem; font-weight: 500; color: var(--blue); }
  .tile__more :global(.icon) { width: 0.95rem; height: 0.95rem; transition: translate 0.4s var(--ease); }
  .tile a:hover .tile__more :global(.icon) { translate: 4px 0; }
  /* la TAC occupa due colonne: testo e scheda a sinistra, macchinario a destra */
  .tile--wide { grid-column: span 2; }
  .tile--wide a { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: clamp(1rem, 2vw, 2rem); }
  .tile--wide .tile__fig { order: 2; align-self: stretch; height: auto; min-height: clamp(260px, 26vw, 360px); }
  .tile--wide .tile__body { padding: 1rem 0.6rem 1rem clamp(0.6rem, 1.5vw, 1.4rem); }
  .tile--wide .tile__t { font-size: clamp(2rem, 1.4rem + 1.8vw, 3.2rem); }
  .tile__spec { display: grid; width: 100%; margin-top: 0.9rem; border-top: 1px solid var(--azure); }
  .tile__spec > span { display: grid; grid-template-columns: 6.5rem 1fr; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid var(--azure); font-size: 0.94rem; color: var(--ink); }
  .tile__spec small { font-size: 0.8rem; color: var(--muted); }
  @media (max-width: 960px) {
    .bento { grid-template-columns: 1fr 1fr; }
    .tile--wide { grid-column: 1 / -1; }
  }
  @media (max-width: 620px) {
    .bento { grid-template-columns: 1fr; }
    .tile--wide a { grid-template-columns: 1fr; }
    .tile--wide .tile__fig { order: 0; min-height: 220px; }
  }
</style>
