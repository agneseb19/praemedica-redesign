---
/** Medici: tutti gli specialisti con ricerca, nello schema della home. */
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import BookBand from '../components/BookBand.astro';
import { getPage, stripTags, type Block } from '../lib/content';

const page = getPage('medici');
const heading = page.blocks.find((b) => b.type === 'heading') as Extract<Block, { type: 'heading' }>;
type Doc = { name: string; role: string; img: string; alt: string; cv?: string };
const docs: Doc[] = [];
for (const b of page.blocks) {
  if (b.type === 'imagebox') docs.push({ name: b.title, role: b.desc, img: b.src, alt: b.alt });
  else if (b.type === 'button' && /\.pdf$/i.test(b.href) && docs.length) docs[docs.length - 1].cv = b.href;
}
---
<Base title={page.seo?.title ?? 'Medici'} description={page.seo?.description}>
  <PageHero crumbs={[{ label: 'Home', href: '/' }, { label: 'Medici' }]} title={stripTags(heading.html)} lead={`${docs.length} medici e professionisti, dalla cardiologia alla fisioterapia.`} />

  <section class="sec" aria-labelledby="docs-t">
    <SectionHead n="01" id="docs-t" title="I medici del centro" desc="Cerca per nome o per specialità.">
      <label class="find" data-reveal>
        <Icon name="search" />
        <span class="sr-only">Cerca un medico per nome o specialità</span>
        <input type="search" placeholder="Nome o specialità" data-filter-input="docs" autocomplete="off" />
        <span class="find__n" data-filter-count="docs">{docs.length}</span>
      </label>
    </SectionHead>
    <div class="wrap">
      <ul class="docs" role="list" data-filter-list="docs">
        {docs.map((d, i) => (
          <li class="d" data-filter-item data-name={`${d.name} ${d.role}`.toLowerCase()} data-reveal>
            <div class="d__pic"><Img src={d.img} alt={d.alt} sizes="(min-width: 1200px) 300px, (min-width: 700px) 30vw, 46vw" widths={[300, 560]} loading={i < 8 ? 'eager' : 'lazy'} /></div>
            <p class="d__r">{d.role}</p>
            <h2 class="d__n">{d.name}</h2>
            {d.cv && <a class="more d__cv" href={d.cv} target="_blank" rel="noopener">Curriculum V. <Icon name="arrow-up-right" /></a>}
          </li>
        ))}
      </ul>
      <p class="empty" data-filter-empty="docs" hidden>Nessun medico corrisponde alla ricerca. Prova con la specialità, per esempio “Cardiologo”.</p>
    </div>
  </section>

  <BookBand />
</Base>

<style>
  .find { display: flex; align-items: center; gap: 0.9rem; width: min(100%, 620px); min-height: 64px; margin-top: 1rem; padding: 0 1.5rem; background: #fff; border: 1px solid var(--azure); border-radius: 999px; text-align: left; transition: border-color 0.3s, box-shadow 0.3s; }
  .find:focus-within { border-color: var(--blue); box-shadow: 0 0 0 4px rgb(56 124 145 / 0.14); }
  .find input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; font: inherit; font-size: 1.05rem; }
  .find :global(.icon) { width: 1.25rem; height: 1.25rem; color: var(--blue); }
  .find__n { font-size: 0.85rem; color: var(--muted); font-variant-numeric: tabular-nums; }
  .docs { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 2.4rem 1.2rem; }
  .d[hidden] { display: none; }
  .d__pic { aspect-ratio: 4 / 5; overflow: hidden; border-radius: var(--r); background: var(--ice); }
  .d__pic :global(picture), .d__pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .d:hover .d__pic :global(img) { transform: scale(1.04); }
  .d__r { margin-top: 0.9rem; font-size: 0.82rem; color: var(--muted); }
  .d__n { margin-top: 0.2rem; font-size: 1.05rem; font-weight: 500; letter-spacing: -0.015em; color: var(--deep); }
  .d__cv { margin-top: 0.7rem; }
  .empty { margin-top: 2rem; text-align: center; font-size: 1.05rem; }
  @media (max-width: 1024px) { .docs { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .docs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 0.8rem; } .d__n { font-size: 0.95rem; } }
</style>
