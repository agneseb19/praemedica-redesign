---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import { getPage, summaryOf, stripTags, fixLogo, type Block } from '../lib/content';
import { site } from '../data/site';
import reviews from '../data/reviews.json';
import { Picture } from 'astro:assets';
import heroPhoto from '../assets/found/sala-attesa-4k.jpg';
import ExamScroller from '../components/ExamScroller.astro';
import BookBand from '../components/BookBand.astro';
import { machines } from '../lib/machines';

const home = getPage('home');
const B = home.blocks;
const of = <T extends Block['type']>(t: T) => B.filter((b) => b.type === t) as Extract<Block, { type: T }>[];
const [heroSlider] = of('slides');
const [receptionImg, waitingImg, fisioImg, palestraImg] = of('image');
const heads = of('heading');
const h = (re: RegExp) => stripTags(heads.find((x) => re.test(x.html))!.html);
const carousels = of('carousel');
const flips = carousels.flatMap((c) => c.slides.flat()).filter((x) => x.type === 'flip') as Extract<Block, { type: 'flip' }>[];
const logos = (carousels.flatMap((c) => c.slides.flat()).filter((x) => x.type === 'image') as Extract<Block, { type: 'image' }>[]).map(fixLogo);
const tac = heroSlider.slides[0];

/* ---------- specializzazioni e corpo 3D ---------- */
const specs = flips.map((f) => summaryOf(f.href, f.front));
/* organo del modello 3D (nome della mesh in praemedica-corpo.glb) per ogni specializzazione che ne ha uno */
const SPOTS: Record<string, { zone: string; mesh: string }> = {
  '/neurologia-neurochirurgia/': { zone: 'Encefalo', mesh: 'encefalo' },
  '/oculistica/': { zone: 'Occhi', mesh: 'occhio_destro' },
  '/otorinolaringoiatria/': { zone: 'Gola', mesh: 'trachea' },
  '/endocrinologia/': { zone: 'Ghiandole surrenali', mesh: 'surrene_destro' },
  '/diabetologia/': { zone: 'Pancreas', mesh: 'pancreas' },
  '/pneumologia/': { zone: 'Polmoni', mesh: 'polmone_destro' },
  '/cardiologia/': { zone: 'Cuore', mesh: 'cuore' },
  '/angiologia/': { zone: 'Vasi sanguigni', mesh: 'aorta' },
  '/gastroenterologia/': { zone: 'Stomaco e intestino', mesh: 'stomaco' },
  '/nefrologia/': { zone: 'Reni', mesh: 'rene_sinistro' },
  '/urologia/': { zone: 'Vescica', mesh: 'vescica' },
  '/ortopedia/': { zone: 'Ossa', mesh: 'osso_left_femur' },
  '/reumatologia/': { zone: 'Articolazioni', mesh: 'osso_right_patella' },
};
const spotted = specs.filter((s) => SPOTS[s.href]).map((s) => ({ ...s, ...SPOTS[s.href] }));
const firstSpot = Math.max(0, spotted.findIndex((s) => s.href === '/cardiologia/'));


/* ---------- medici ---------- */
const medici = getPage('medici');
type Doc = { name: string; role: string; img: string; alt: string };
const docs: Doc[] = medici.blocks.filter((b) => b.type === 'imagebox').map((b: any) => ({ name: b.title, role: b.desc, img: b.src, alt: b.alt }));
const team = docs.slice(0, 10);

/* ---------- ricerca ---------- */
const searchIndex = [
  ...specs.map((s) => ({ t: s.label, k: 'Specializzazione', h: s.href, x: s.doctors.join(' ') + ' ' + s.services.join(' ') })),
  ...machines.map((m) => ({ t: m.exam, k: 'Alta diagnostica', h: m.href, x: m.device })),
  { t: 'Fisioterapia', k: 'Riabilitazione', h: '/fisioterapia/', x: 'tecarterapia laserterapia massoterapia' },
  { t: 'Palestra Riabilitativa', k: 'Riabilitazione', h: '/palestra-riabilitativa/', x: 'ginnastica posturale rieducazione' },
  ...docs.map((d) => ({ t: d.name, k: d.role, h: `/medici/?q=${encodeURIComponent(d.name)}`, x: '' })),
];

const withText = reviews.reviews.filter((r) => r.text);
const noText = reviews.reviews.filter((r) => !r.text);
---
<Base title="Praemedica - Centro Diagnostico Polispecialistico" description={home.seo?.description}>

  <!-- HERO: la sala d'attesa di Praemedica a tutto schermo, testo sopra a sinistra.
       Foto originale 1080px ingrandita 4x con Real-ESRGAN (4320×2432), nitida anche su schermi 4K.
       Il testo sta a destra, su una sfumatura leggera: a sinistra si vedono intatti logo e accettazione. -->
  <section class="hero" aria-labelledby="hero-t">
    <figure class="hero__pic" data-parallax="5">
      <Picture src={heroPhoto} alt={waitingImg.alt || "La sala d'attesa del centro Praemedica"} formats={['webp']} widths={[1000, 1600, 2400, 3200, 4320]} sizes="100vw" quality={84} loading="eager" fetchpriority="high" />
    </figure>
    <div class="wrap hero__copy">
      <p class="hero__k" data-reveal>{h(/^CENTRO DIAGNOSTICO/)} {h(/^PRAEMEDICA/)} · Palestrina</p>
      <h1 id="hero-t" class="hero__t" data-lines>La tecnologia al servizio della tua salute.</h1>
      <p class="hero__p" data-reveal>Il punto di riferimento per la tua salute: visite specialistiche, alta diagnostica e riabilitazione in un unico centro.</p>
      <div class="hero__btns" data-reveal>
        <a class="btn btn--green" href={site.doctolib.href} target="_blank" rel="noopener">Prenota una visita</a>
        <a class="btn btn--white" href="#esplora">Esplora le prestazioni</a>
      </div>
    </div>
  </section>

  <!-- informazioni pratiche, appoggiate sotto la hero -->
  <div class="wrap facts-wrap">
    <ul class="facts" role="list">
      <li class="fact" data-open-badge>
        <Icon name="clock" />
        <span><strong data-open-text>Orari di apertura</strong><small>{site.hours.footer.map((x) => x.replace('Orari: ', '')).join(' · ')}</small></span>
      </li>
      <li class="fact"><a href={site.phone.href}><Icon name="phone" /><span><strong>{site.phone.label}</strong><small>Chiama per prenotare</small></span></a></li>
      <li class="fact"><a href={site.whatsapp.href} target="_blank" rel="noopener"><Icon name="brand-whatsapp" /><span><strong>{site.whatsapp.label}</strong><small>Scrivici su WhatsApp</small></span></a></li>
      <li class="fact"><a href={site.address.maps} target="_blank" rel="noopener"><Icon name="map-pin" /><span><strong>{site.address.street}</strong><small>{site.address.building}, {site.address.city}</small></span></a></li>
    </ul>
  </div>

  <!-- 01 · CHI È PRAEMEDICA: cosa trovi al centro, in tre parti -->
  <section class="sec" aria-labelledby="chi-t">
    <header class="wrap sh">
      <span class="sh__n">01</span>
      <h2 id="chi-t" class="sh__t" data-lines>Chi è Praemedica</h2>
      <p class="sh__d" data-reveal>Praemedica è un centro diagnostico polispecialistico a Palestrina. Nasce dall’unione di due realtà di eccellenza nel settore medico e ortopedico, con un’esperienza consolidata e competenze solide. Visite specialistiche, alta diagnostica e riabilitazione, in un unico centro.</p>
    </header>
    <ul class="wrap pillars" role="list">
      <li data-reveal>
        <a class="pillar" href="/specializzazioni/">
          <div class="pillar__pic"><Img src={receptionImg.src} alt={receptionImg.alt} sizes="(min-width: 900px) 33vw, 100vw" widths={[500, 1000]} /></div>
          <h3 class="pillar__t">Visite specialistiche</h3>
          <p class="pillar__p">{specs.length} specializzazioni, dalla cardiologia all’urologia, con medici esperti.</p>
          <span class="more">Le specializzazioni</span>
        </a>
      </li>
      <li data-reveal>
        <a class="pillar" href="/alta-diagnostica/">
          <div class="pillar__pic"><Img src="wp/2026/09/TAC-scaled.jpg" alt={tac.alt || tac.heading} sizes="(min-width: 900px) 33vw, 100vw" widths={[500, 1000]} /></div>
          <h3 class="pillar__t">Alta diagnostica</h3>
          <p class="pillar__p">TAC, mammografia 3D, radiografie, ortopanoramica e MOC con tecnologie di ultima generazione.</p>
          <span class="more">Gli esami</span>
        </a>
      </li>
      <li data-reveal>
        <a class="pillar" href="/fisioterapia/">
          <div class="pillar__pic"><Img src="wp/2025/02/palestra-riabilitativa-praemedica-centro-diagnostico.jpg" alt="Palestra riabilitativa del centro Praemedica" sizes="(min-width: 900px) 33vw, 100vw" widths={[500, 1000]} /></div>
          <h3 class="pillar__t">Riabilitazione</h3>
          <p class="pillar__p">Fisioterapia e palestra riabilitativa per il recupero della mobilità.</p>
          <span class="more">La riabilitazione</span>
        </a>
      </li>
    </ul>
  </section>

  <!-- 02 · PERCHÉ SCEGLIERE PRAEMEDICA (dalla pagina Chi siamo e dalla home originali) -->
  <section class="sec" aria-labelledby="why-t">
    <header class="wrap sh">
      <span class="sh__n">02</span>
      <h2 id="why-t" class="sh__t" data-lines>Perché scegliere Praemedica</h2>
      <p class="sh__d" data-reveal>Il paziente è il fulcro della nostra attività: un servizio attento e scrupoloso, con assistenza a 360°.</p>
    </header>
    <ul class="wrap why" role="list">
      <li data-reveal><Icon name="users-group" /><h3>Specialisti esperti</h3><p>Un team di specialisti dinamici ed esperti, per {specs.length} specializzazioni.</p></li>
      <li data-reveal><Icon name="device-heart-monitor" /><h3>Tecnologie innovative</h3><p>Apparecchiature di ultima generazione, come la Tac Somatom go.Top 128 strati.</p></li>
      <li data-reveal><Icon name="clock-hour-4" /><h3>Tempi di attesa ridotti</h3><p>Diagnosi rapide e tempi di risposta brevi, senza lunghe liste d’attesa.</p></li>
      <li data-reveal><Icon name="receipt-euro" /><h3>Tariffe competitive</h3><p>Una valida alternativa al Servizio Sanitario Nazionale (SSN), con prestazioni di alta qualità.</p></li>
      <li data-reveal><Icon name="building-hospital" /><h3>Tutto in un unico centro</h3><p>Un approccio multidisciplinare e integrato: visite, esami e riabilitazione.</p></li>
      <li data-reveal><Icon name="shield-check" /><h3>Convenzioni assicurative</h3><p>Convenzioni con {logos.length} tra assicurazioni e casse sanitarie.</p></li>
    </ul>
  </section>

  <!-- 03 · SPECIALIZZAZIONI -->
  <section class="sec" id="esplora" aria-labelledby="body-t">
    <header class="wrap sh">
      <span class="sh__n">03</span>
      <h2 id="body-t" class="sh__t" data-lines>{h(/^Specializzazioni/)}</h2>
      <p class="sh__d" data-reveal>Cerca una visita o uno specialista, scegli dall'elenco oppure tocca un punto del corpo.</p>
      <div class="find__box" data-search data-reveal>
        <label class="find__field">
          <Icon name="search" />
          <span class="sr-only">Cerca una visita, un esame o uno specialista</span>
          <input type="search" placeholder="Cerca una visita, un esame o uno specialista" autocomplete="off" data-search-input aria-controls="find-res" />
        </label>
        <ul id="find-res" class="find__res" role="list" data-search-results hidden></ul>
        <script type="application/json" data-search-index set:html={JSON.stringify(searchIndex)} />
      </div>
    </header>
    <div class="wrap body__grid">
      <ul class="body__list" role="list" data-reveal>
        {specs.map((s) => {
          const k = spotted.findIndex((x) => x.href === s.href);
          return <li><a href={s.href} data-spot-link={k >= 0 ? k : undefined}>{s.label}</a></li>;
        })}
      </ul>

      <div class="body__stage" data-body data-body-first={firstSpot} data-spots={JSON.stringify(spotted.map((s) => s.mesh))}>
        <canvas class="body__canvas" aria-hidden="true"></canvas>
        <div class="body__spots">
          {spotted.map((s, i) => (
            <button type="button" class:list={['spot', { 'is-on': i === firstSpot }]} data-spot={i} aria-pressed={i === firstSpot ? 'true' : 'false'} aria-label={`${s.zone}: ${s.label}`}>
              <span class="spot__tag">{s.zone}</span>
            </button>
          ))}
        </div>
        <p class="body__hint" aria-hidden="true"><Icon name="hand-move" /> Trascina per ruotare</p>
        <p class="body__credit">Modello: <a href="https://dbarchive.biosciencedbc.jp/en/bodyparts3d/lic.html" target="_blank" rel="noopener">BodyParts3D</a>, © The Database Center for Life Science, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>. Geometrie adattate.</p>
      </div>

      <div class="body__panel" aria-live="polite">
        {spotted.map((s, i) => (
          <article class:list={['pane', { 'is-on': i === firstSpot }]} data-spot-pane={i} hidden={i !== firstSpot}>
            <p class="pane__k">{s.zone}</p>
            <h3 class="pane__t">{s.label}</h3>
            {s.firstSentence && <p class="pane__p">{s.firstSentence}</p>}
            {s.services.length > 0 && (
              <ul class="pane__list" role="list">{s.services.slice(0, 4).map((x) => <li>{x}</li>)}</ul>
            )}
            {s.doctors.length > 0 && <p class="pane__docs">{s.doctors.join(', ')}</p>}
            <div class="pane__act">
              <a class="btn btn--green" href={site.doctolib.href} target="_blank" rel="noopener">Prenota</a>
              <a class="more" href={s.href}>Scopri di più</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- 04 · ALTA DIAGNOSTICA -->
  <section class="sec sec--top" aria-labelledby="diag-t">
    <header class="wrap sh">
      <span class="sh__n">04</span>
      <h2 id="diag-t" class="sh__t" data-lines>Alta diagnostica</h2>
      <div class="sh__d" data-reveal>
        <p>{h(/^Alta Diagnostica/)} TAC, mammografia 3D, radiografie, ortopanoramica e MOC con tecnologie di ultima generazione, tempi di attesa ridotti e tariffe competitive.</p>
        <a class="more" href="/alta-diagnostica/">Tutti gli esami</a>
      </div>
    </header>
  </section>
  <ExamScroller />

  <!-- 05 · SPECIALISTI -->
  <section class="sec" aria-labelledby="team-t">
    <header class="wrap sh">
      <span class="sh__n">05</span>
      <h2 id="team-t" class="sh__t" data-lines>I nostri specialisti</h2>
      <div class="sh__d" data-reveal>
        <p>I {docs.length} medici e professionisti del centro, dalla cardiologia alla fisioterapia.</p>
        <a class="more" href="/medici/">Tutti i medici</a>
      </div>
    </header>
    <ul class="rail team__row" role="list" data-rail="team">
      {team.map((d) => (
        <li class="doc">
          <a href={`/medici/?q=${encodeURIComponent(d.name)}`}>
            <div class="doc__pic"><Img src={d.img} alt={d.alt} sizes="(min-width: 1024px) 20vw, 60vw" widths={[320, 600]} /></div>
            <p class="doc__n">{d.name}</p>
            <p class="doc__r">{d.role}</p>
          </a>
        </li>
      ))}
    </ul>
    <div class="wrap rail-nav">
      <button type="button" data-rail-prev="team" aria-label="Medici precedenti"><Icon name="arrow-left" /></button>
      <button type="button" data-rail-next="team" aria-label="Medici successivi"><Icon name="arrow-right" /></button>
    </div>
  </section>

  <!-- 06 · RIABILITAZIONE -->
  <section class="sec" aria-labelledby="reha-t">
    <header class="wrap sh">
      <span class="sh__n">06</span>
      <h2 id="reha-t" class="sh__t" data-lines>Riabilitazione</h2>
      <p class="sh__d" data-reveal>Fisioterapia e palestra riabilitativa: percorsi personalizzati per il recupero della mobilità, con specialisti esperti e tecnologie moderne.</p>
    </header>
    <div class="wrap reha" data-switch>
      <div class="reha__list">
        <a class="reha__item is-on" href="/fisioterapia/" data-switch-btn="0">
          <span class="reha__n">01</span>
          <span class="reha__body">
            <h3 class="reha__t">{h(/^Fisioterapia/)}</h3>
            <span class="reha__p">Tecarterapia, laserterapia, terapia manuale, pressoterapia, magnetoterapia, elettroterapia, ultrasuoni e massoterapia.</span>
            <span class="more">Fisioterapia</span>
          </span>
        </a>
        <a class="reha__item" href="/palestra-riabilitativa/" data-switch-btn="1">
          <span class="reha__n">02</span>
          <span class="reha__body">
            <h3 class="reha__t">{h(/^Palestra Riabilitativa/)}</h3>
            <span class="reha__p">Esercizio terapeutico, ginnastica correttiva e posturale, rieducazione neuromotoria.</span>
            <span class="more">Palestra Riabilitativa</span>
          </span>
        </a>
      </div>
      <div class="reha__pics">
        <figure class="reha__pic is-on" data-switch-pane="0"><Img src={fisioImg.src} alt={fisioImg.alt} sizes="(min-width: 900px) 58vw, 100vw" widths={[700, 1366]} /></figure>
        <figure class="reha__pic" data-switch-pane="1"><Img src={palestraImg.src} alt={palestraImg.alt} sizes="(min-width: 900px) 58vw, 100vw" widths={[700, 1366]} /></figure>
      </div>
    </div>
  </section>

  <!-- 07 · RECENSIONI -->
  <section class="sec" aria-labelledby="voci-t">
    <header class="wrap sh">
      <span class="sh__n">07</span>
      <h2 id="voci-t" class="sh__t" data-lines>{h(/Dicono di Noi/)}</h2>
      <div class="score" data-reveal>
        <p class="score__big">{reviews.label}</p>
        <p class="score__meta"><span class="stars" aria-label="5 stelle su 5">{Array.from({ length: 5 }, () => <Icon name="star-filled" />)}</span> {reviews.count} su <Icon name="brand-google" label="Google" /></p>
      </div>
    </header>
    <ul class="rail voci__row" role="list" data-rail="voci">
      {withText.map((r) => (
        <li class="voce">
          <span class="stars" aria-label="5 stelle su 5">{Array.from({ length: 5 }, () => <Icon name="star-filled" />)}</span>
          <blockquote><p>{r.text.split('\n').map((l, k) => (k ? <><br />{' '}{l}</> : l))}</p></blockquote>
          <p class="voce__by"><img src={r.avatar} alt={`${r.name} profile picture`} width="40" height="40" loading="lazy" /><span><strong>{r.name}</strong><span>Pubblicato su Google</span></span></p>
        </li>
      ))}
    </ul>
    <div class="wrap rail-nav">
      <button type="button" data-rail-prev="voci" aria-label="Recensioni precedenti"><Icon name="arrow-left" /></button>
      <button type="button" data-rail-next="voci" aria-label="Recensioni successive"><Icon name="arrow-right" /></button>
    </div>
    <p class="wrap voci__note">5 stelle anche da {noText.map((r, i) => <>{i ? ' e ' : ''}<img src={r.avatar} alt={`${r.name} profile picture`} width="18" height="18" loading="lazy" /> {r.name}</>)}. {reviews.verified} Verificato da Trustindex: Trustindex ha verificato che queste recensioni sono state pubblicate sul Profilo dell'attività su Google di <a href={site.address.maps} target="_blank" rel="noopener">Praemedica</a>. <a href="https://www.trustindex.io/?a=sys&c=wp-verified-badge&url=/review-platform-verification/" target="_blank" rel="noopener">Scopri di più</a></p>
  </section>

  <!-- 08 · CONVENZIONI -->
  <section class="sec sec--short" aria-labelledby="conv-t">
    <header class="wrap sh">
      <span class="sh__n">08</span>
      <h2 id="conv-t" class="sh__t" data-lines>Convenzioni Assicurative</h2>
      <div class="sh__d" data-reveal><p>Praemedica è convenzionata con le principali assicurazioni e casse sanitarie.</p><a class="more" href="/convenzioni/">Tutte le convenzioni</a></div>
    </header>
    <div class="wrap">
      <ul class="conv__logos" role="list" data-reveal>
        {logos.map((l) => <li><a href={l.href} target="_blank" rel="noopener"><Img src={l.src} alt={l.alt || 'UniSalute'} sizes="140px" widths={[140, 280]} /></a></li>)}
      </ul>
    </div>
  </section>

  <!-- PRENOTA -->
  <BookBand />
</Base>

<script>
  import '../scripts/body3d';
  /* file scorrevoli (medici, recensioni): frecce che avanzano di una "pagina" */
  document.querySelectorAll<HTMLElement>('[data-rail]').forEach((rail) => {
    const key = rail.dataset.rail;
    const step = (dir: number) => rail.scrollBy({ left: dir * rail.clientWidth * 0.8, behavior: 'smooth' });
    document.querySelector(`[data-rail-prev="${key}"]`)?.addEventListener('click', () => step(-1));
    document.querySelector(`[data-rail-next="${key}"]`)?.addEventListener('click', () => step(1));
  });
</script>

<style>
  /* ============ schema comune a ogni sezione: numero · etichetta e titolo · spiegazione ============ */
  .sec { padding-block: clamp(3.5rem, 2.5rem + 3.5vw, 6.5rem); }
  .sec + .sec, .prod + .sec { padding-top: 0; }
  .sec--short { padding-block: clamp(3.5rem, 2.5rem + 3.5vw, 6.5rem); }
  .sec--top { padding-bottom: 0; display: flow-root; }
  .sec--top .sh { margin-bottom: 0; padding-bottom: clamp(2rem, 3vw, 3rem); }
  .sh { display: grid; justify-items: center; gap: 1rem; max-width: 60rem; margin: 0 auto clamp(2.5rem, 4vw, 3.5rem); text-align: center; }
  .sh__n { display: inline-flex; align-items: center; gap: 0.8rem; font-size: 0.85rem; font-weight: 500; font-variant-numeric: tabular-nums; color: var(--green); }
  .sh__n::before, .sh__n::after { content: ''; width: 2rem; height: 1px; background: currentColor; opacity: 0.5; }
  .sh__t { font-size: clamp(2.2rem, 1.4rem + 2.4vw, 3.6rem); font-weight: 500; line-height: 1.05; letter-spacing: -0.045em; color: var(--deep); }
  .sh__d { max-width: 58ch; font-size: 1.02rem; line-height: 1.6; color: var(--ink-2); }
  .sh .more { margin-top: 0.2rem; }

  /* 01 · tre colonne: cosa trovi al centro */
  .pillars { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(1rem, 2vw, 1.5rem); }
  .pillar { display: grid; gap: 0.8rem; justify-items: start; text-decoration: none; }
  .pillar__pic { width: 100%; aspect-ratio: 4 / 3; overflow: hidden; border-radius: 24px; margin-bottom: 0.4rem; }
  .pillar__pic :global(picture), .pillar__pic :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 1.4s var(--ease); }
  .pillar:hover .pillar__pic :global(img) { transform: scale(1.04); }
  .pillar__t { font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.7rem); font-weight: 500; letter-spacing: -0.03em; color: var(--deep); }
  .pillar__p { font-size: 0.95rem; line-height: 1.55; color: var(--ink-2); }

  /* ================= HERO ================= */
