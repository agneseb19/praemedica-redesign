---
/**
 * Radiologia Generale. La pagina originale è un listino: quattro esami, ciascuno con le sue prestazioni.
 * Apertura con il mosaico dei quattro macchinari (che porta al gruppo di esami), poi il testo
 * introduttivo come dichiarazione, poi il listino ordinato. Testi 1:1 dall'originale.
 */
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import Icon from '../components/Icon.astro';
import SectionHead from '../components/SectionHead.astro';
import BookBand from '../components/BookBand.astro';
import { getPage, stripTags, type Block } from '../lib/content';
import { site } from '../data/site';

const page = getPage('radiologia');
const blocks = page.blocks;
const h1 = (blocks.find((b) => b.type === 'heading' && (b as any).level === 1) as any)?.html ?? page.title;
const intro = (blocks.find((b) => b.type === 'text') as Extract<Block, { type: 'text' }>)?.html ?? '';
const introParas = intro.match(/<p[\s\S]*?<\/p>/g) ?? [intro];

/* un gruppo per ogni h2: foto, prestazioni, link alla pagina dell'esame */
interface Group { id: string; title: string; img?: { src: string; alt: string }; more?: string; book?: { href: string; text: string }; services: string[]; sub?: string }
const groups: Group[] = [];
for (const b of blocks) {
  if (b.type === 'heading' && b.level === 2) groups.push({ id: '', title: b.html, services: [] });
  const g = groups.at(-1);
  if (!g) continue;
  if (b.type === 'heading' && b.level === 3) g.sub = b.html;
  if (b.type === 'image') g.img = { src: b.src, alt: b.alt };
  if (b.type === 'list') g.services.push(...b.items.map((i) => i.text));
  if (b.type === 'button') b.href.startsWith('tel:') ? (g.book = { href: b.href, text: b.text }) : (g.more = b.href);
}
const SLUG: Record<string, string> = { 'Densitometria Ossea (MOC)': 'moc', 'Mammografia 3D in Tomosintesi': 'mammografia', 'Radiografie (RX)': 'rx', Ortopanoramica: 'ortopanoramica' };
groups.forEach((g, i) => (g.id = SLUG[stripTags(g.title)] ?? `esame-${i + 1}`));

/* "MOC LOMBARE E FEMORALE" -> "MOC lombare e femorale": più leggibile, stesse parole */
const KEEP = new Set(['MOC', 'RX', '3D', 'ECO']);
const tidy = (s: string) => s.split(' ').map((w, i) => (KEEP.has(w) ? w : i === 0 ? w.charAt(0) + w.slice(1).toLowerCase() : w.toLowerCase())).join(' ');
---
<Base title={page.seo?.title ?? stripTags(h1)} description={page.seo?.description}>
  <!-- Apertura: titolo e il mosaico dei quattro macchinari -->
  <section class="rh">
    <div class="wrap rh__grid">
      <div class="rh__in">
        <nav class="rh__crumbs" aria-label="Percorso"><a href="/">Home</a><span aria-hidden="true">/</span><a href="/specializzazioni/">Specializzazioni</a><span aria-hidden="true">/</span><span aria-current="page">Radiologia</span></nav>
        <h1 class="rh__t" data-lines set:html={h1} />
        <p class="rh__lead" data-reveal>Quattro esami, {groups.reduce((n, g) => n + g.services.length, 0)} prestazioni. Scegli l'esame per vedere cosa puoi prenotare.</p>
        <div class="rh__act" data-reveal>
          <a class="btn btn--green" href={site.doctolib.href} target="_blank" rel="noopener">Prenota online</a>
          <a class="btn btn--line" href={site.phone.href}><Icon name="phone" /> {site.phone.label}</a>
        </div>
      </div>
      <ul class="rh__mosaic" role="list">
        {groups.map((g, i) => (
          <li class={`rh__tile rh__tile--${i + 1}`}>
            <a href={`#${g.id}`}>
              {g.img && <Img src={g.img.src} alt={g.img.alt} loading="eager" sizes="(min-width: 900px) 26vw, 46vw" widths={[400, 700]} />}
              <span class="rh__lab"><span set:html={g.title} /><Icon name="arrow-down" /></span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 01 Il servizio: il testo introduttivo come dichiarazione -->
  <section class="sec" aria-labelledby="serv-t">
    <SectionHead n="01" id="serv-t" title="Il servizio" />
    <div class="wrap say">
      <div class="say__big" data-reveal set:html={introParas[0]} />
      <div class="say__small" data-reveal>
        <div set:html={introParas.slice(1).join('')} />
        <ul class="say__pts" role="list">
          <li><Icon name="cpu" /> Tecnologie di ultima generazione</li>
          <li><Icon name="clock-hour-4" /> Tempi di attesa ridotti</li>
          <li><Icon name="receipt-euro" /> Tariffe concorrenziali</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- 02 Listino: un gruppo per esame -->
  <section class="sec" aria-labelledby="list-t">
    <SectionHead n="02" id="list-t" title="Esami e prestazioni" desc="Tutte le prestazioni di radiologia, divise per esame." />
    <div class="wrap menu">
      {groups.map((g, i) => (
        <article id={g.id} class="menu__g" data-reveal>
          <header class="menu__h">
            <span class="menu__n">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="menu__t" set:html={g.title} />
            <span class="menu__c">{g.services.length} prestazioni</span>
            <div class="menu__act">
              {g.more && <a class="btn btn--line" href={g.more}>Scopri di più</a>}
              {g.book && <a class="btn btn--green" href={g.book.href}><Icon name="phone" /> {g.book.text}</a>}
            </div>
          </header>
          {g.sub && <p class="sr-only" set:html={g.sub} />}
          <ul class:list={['menu__l', { 'menu__l--long': g.services.length > 8 }]} role="list">
            {g.services.map((s) => <li><Icon name="check" /><span>{tidy(s)}</span></li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <BookBand />
</Base>

<style>
  /* ---------- apertura: titolo + mosaico ---------- */
  .rh { background: var(--ice); }
  .rh__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .rh__in { display: grid; gap: 1.3rem; justify-items: start; }
  .rh__crumbs { display: flex; flex-wrap: wrap; gap: 0.6rem; font-size: 0.85rem; color: var(--muted); }
  .rh__crumbs a { color: inherit; text-decoration: none; }
  .rh__crumbs a:hover { text-decoration: underline; }
  .rh__t { max-width: 10ch; font-size: clamp(2.8rem, 1.4rem + 4.4vw, 5.6rem); font-weight: 500; line-height: 0.98; letter-spacing: -0.055em; color: var(--deep); }
  .rh__lead { max-width: 34ch; font-size: 1.15rem; line-height: 1.55; color: var(--ink-2); }
  .rh__act { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .rh__act .btn--line { background: #fff; }

  .rh__mosaic { list-style: none; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1.35fr) minmax(0, 1fr); gap: 0.8rem; height: clamp(460px, 70vh, 680px); }
  .rh__tile { min-height: 0; }
  .rh__tile a { position: relative; display: block; height: 100%; overflow: hidden; border-radius: var(--r); background: #fff; text-decoration: none; }
  .rh__tile :global(picture), .rh__tile :global(img) { width: 100%; height: 100%; object-fit: cover; transition: transform 0.8s var(--ease); }
  .rh__tile a:hover :global(img) { transform: scale(1.04); }
  .rh__lab { position: absolute; left: 0.8rem; right: 0.8rem; bottom: 0.8rem; display: flex; align-items: center; justify-content: space-between; gap: 0.6rem; padding: 0.8rem 1rem; background: rgb(255 255 255 / 0.92); border-radius: 14px; font-size: 1rem; font-weight: 500; line-height: 1.25; color: var(--deep); backdrop-filter: blur(6px); }
  .rh__lab :global(.icon) { flex: none; width: 1.1rem; height: 1.1rem; color: var(--green); transition: transform 0.4s var(--ease); }
  .rh__tile a:hover .rh__lab :global(.icon) { transform: translateY(3px); }

  /* ---------- 01 dichiarazione ---------- */
  .say { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .say__big { font-size: clamp(1.5rem, 1.1rem + 1.3vw, 2.3rem); font-weight: 400; line-height: 1.35; letter-spacing: -0.025em; color: var(--deep); }
  .say__big :global(strong) { font-weight: 500; color: var(--blue); }
  .say__small { display: grid; gap: 1.6rem; font-size: 1.05rem; line-height: 1.7; color: var(--ink-2); }
  .say__small :global(strong) { color: var(--ink); font-weight: 600; }
  .say__pts { list-style: none; display: grid; border-top: 1px solid var(--line); }
  .say__pts li { display: flex; align-items: center; gap: 0.8rem; padding: 0.9rem 0; border-bottom: 1px solid var(--line); font-weight: 500; color: var(--deep); }
  .say__pts :global(.icon) { width: 1.3rem; height: 1.3rem; color: var(--green); }

  /* ---------- 02 listino ---------- */
  .menu { display: grid; gap: clamp(1rem, 2vw, 1.4rem); }
  .menu__g { scroll-margin-top: 110px; padding: clamp(1.5rem, 3vw, 2.5rem); background: #fff; border: 1px solid var(--line-2); border-radius: var(--r); }
  .menu__h { display: grid; grid-template-columns: auto minmax(0, 1fr) auto; grid-template-areas: 'n t act' 'n c act'; align-items: center; gap: 0.2rem 1.2rem; padding-bottom: 1.4rem; border-bottom: 1px solid var(--line); }
  .menu__n { grid-area: n; display: grid; place-items: center; width: 3.4rem; height: 3.4rem; border-radius: 50%; background: var(--ice); font-size: 0.95rem; font-weight: 500; color: var(--green); font-variant-numeric: tabular-nums; }
  .menu__t { grid-area: t; font-size: clamp(1.4rem, 1.1rem + 1vw, 2rem); font-weight: 500; line-height: 1.15; letter-spacing: -0.035em; color: var(--deep); }
  .menu__c { grid-area: c; font-size: 0.92rem; color: var(--muted); }
  .menu__act { grid-area: act; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .menu__l { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2rem; margin-top: 0.6rem; }
  .menu__l--long { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .menu__l li { display: flex; align-items: center; gap: 0.7rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line); font-size: 1.02rem; color: var(--ink); }
  .menu__l :global(.icon) { flex: none; width: 1.1rem; height: 1.1rem; color: var(--green); }

  @media (max-width: 960px) {
    .rh__grid, .say { grid-template-columns: 1fr; }
    .rh__mosaic { height: auto; grid-template-rows: none; grid-auto-rows: 220px; }
    .menu__l--long { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .rh__mosaic { grid-auto-rows: 170px; gap: 0.6rem; }
    .rh__lab { left: 0.5rem; right: 0.5rem; bottom: 0.5rem; padding: 0.6rem 0.7rem; font-size: 0.88rem; }
    .rh__act, .rh__act .btn { width: 100%; }
    .menu__h { grid-template-columns: auto minmax(0, 1fr); grid-template-areas: 'n t' 'n c' 'act act'; }
    .menu__act { margin-top: 1rem; }
    .menu__act .btn { flex: 1 1 auto; }
    .menu__l, .menu__l--long { grid-template-columns: 1fr; }
  }
</style>
