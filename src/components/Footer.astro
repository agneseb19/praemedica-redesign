---
/**
 * Footer, uguale in tutte le pagine: logo e prenotazione, quattro colonne
 * (contatti, orari, alta diagnostica, pagine), poi note legali e social.
 * Tutti i testi sono quelli del footer originale.
 */
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="foot">
  <div class="wrap foot__top">
    <div class="foot__brand">
      <a class="foot__logo" href="/" aria-label="Praemedica, home"><img src="/brand/logo.png" alt="logo praemedica scontornato" width="617" height="124" loading="lazy" /></a>
      <p class="foot__claim">Centro diagnostico polispecialistico a Palestrina: visite specialistiche, alta diagnostica e riabilitazione.</p>
    </div>
    <div class="foot__cta">
      <a class="btn btn--green" href={site.doctolib.href} target="_blank" rel="noopener">Prenota online</a>
      <a class="btn btn--line" href={site.phone.href}><Icon name="phone" /> {site.phone.label}</a>
    </div>
  </div>

  <div class="wrap foot__grid">
    <div class="foot__col">
      <h2 class="foot__h">Contatti</h2>
      <address class="foot__l">
        <a class="foot__i" href={site.address.maps} target="_blank" rel="noopener"><Icon name="map-pin" /><span>{site.address.street}<br />{site.address.building}<br />{site.address.city}</span></a>
        <a class="foot__i" href={site.phone.href}><Icon name="phone" /><span>Telefono: {site.phone.footer}</span></a>
        <a class="foot__i" href={site.whatsapp.href} target="_blank" rel="noopener"><Icon name="brand-whatsapp" /><span>WhatsApp: {site.whatsapp.label}</span></a>
        <a class="foot__i" href={site.email.href}><Icon name="mail" /><span>Email: {site.email.label}</span></a>
      </address>
    </div>
    <div class="foot__col">
      <h2 class="foot__h">Orari</h2>
      <p class="foot__l">{site.hours.footer.map((h) => <span>{h}</span>)}</p>
      <p class="foot__open" data-open-badge><span class="foot__dot" aria-hidden="true"></span><span data-open-text></span></p>
    </div>
    <div class="foot__col">
      <h2 class="foot__h">Alta Diagnostica</h2>
      <ul class="foot__l">
        <li><a href="/tac/">TAC</a></li>
        <li><a href="/densitometria-ossea/">Moc</a></li>
        <li><a href="/mammografia-in-tomosintesi/">Mammografia in Tomosintesi</a></li>
        <li><a href="/ortopanoramica/">Ortopanoramica</a></li>
      </ul>
    </div>
    <div class="foot__col">
      <h2 class="foot__h">Praemedica</h2>
      <ul class="foot__l">
        <li><a href="/chi-siamo/">Chi Siamo</a></li>
        <li><a href="/specializzazioni/">Specializzazioni</a></li>
        <li><a href="/medici/">Medici</a></li>
        <li><a href="/convenzioni/">Convenzioni</a></li>
        <li><a href="/contatti/">Contatti</a></li>
      </ul>
    </div>
  </div>

  <div class="wrap foot__end">
    <div class="foot__copy">
      <p>{site.copyright} <a href={site.credits.href} target="_blank" rel="noopener">{site.credits.label}</a></p>
      <p class="foot__photo">Alcune foto d’atmosfera: <a href="https://unsplash.com" target="_blank" rel="noopener">Unsplash</a> e <a href="https://www.pexels.com" target="_blank" rel="noopener">Pexels</a> (Accuray e altri autori, licenze Unsplash e Pexels).</p>
    </div>
    <div class="foot__right">
      <p class="foot__legal"><span>Privacy</span> <a href={site.privacy.policy.href} target="_blank" rel="noopener">{site.privacy.policy.label}</a> <a href={site.privacy.cookie.href} target="_blank" rel="noopener">{site.privacy.cookie.label}</a></p>
      <p class="foot__social">
        <a href={site.social.facebook} target="_blank" rel="noopener"><Icon name="brand-facebook" /> Facebook</a>
        <a href={site.social.instagram} target="_blank" rel="noopener"><Icon name="brand-instagram" /> Instagram</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot { background: var(--ice); color: var(--ink-2); padding-top: clamp(3.5rem, 2.5rem + 3vw, 5.5rem); }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--green-ink); }

  .foot__top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.5rem 3rem; padding-bottom: clamp(2.5rem, 4vw, 3.5rem); border-bottom: 1px solid var(--azure); }
  .foot__brand { display: grid; gap: 1rem; max-width: 34rem; }
  .foot__logo img { height: 42px; width: auto; }
  .foot__claim { font-size: 0.98rem; line-height: 1.6; color: var(--ink-2); }
  .foot__cta { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .foot__cta .btn--line { background: #fff; border-color: var(--azure); }

  .foot__grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 2.5rem clamp(1.5rem, 3vw, 3rem); padding-block: clamp(2.5rem, 4vw, 3.5rem); }
  .foot__h { margin-bottom: 1.1rem; font-size: 1.05rem; font-weight: 500; letter-spacing: -0.015em; color: var(--deep); }
  .foot__l { list-style: none; display: grid; gap: 0.7rem; font-style: normal; font-size: 0.95rem; line-height: 1.5; }
  .foot__l span { display: block; }
  .foot__i { display: flex; align-items: flex-start; gap: 0.7rem; }
  .foot__i :global(.icon) { flex: none; width: 1.1rem; height: 1.1rem; margin-top: 0.15rem; color: var(--green); }
  .foot__open { display: inline-flex; align-items: center; gap: 0.5rem; margin-top: 1rem; padding: 0.45rem 0.9rem; background: #fff; border-radius: 999px; font-size: 0.85rem; color: var(--deep); }
  .foot__dot { width: 8px; height: 8px; border-radius: 50%; background: #9aa6b2; }
  .foot__open:global(.is-open) .foot__dot { background: var(--green); }

  .foot__end { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding-block: 1.6rem 6rem; border-top: 1px solid var(--azure); font-size: 0.82rem; color: var(--muted); }
  .foot__copy a, .foot__legal a { color: var(--deep); text-decoration: underline; text-underline-offset: 0.2em; }
  .foot__copy { display: grid; gap: 0.3rem; }
  .foot__photo { font-size: 0.75rem; }
  .foot__right { display: flex; flex-wrap: wrap; align-items: center; gap: 0.8rem 2rem; }
  .foot__legal { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; }
  .foot__legal span { font-weight: 500; color: var(--deep); }
  .foot__social { display: flex; gap: 1.2rem; }
  .foot__social a { display: inline-flex; align-items: center; gap: 0.4rem; color: var(--deep); }
  .foot__social :global(.icon) { width: 1.1rem; height: 1.1rem; }

  @media (max-width: 960px) { .foot__grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) {
    .foot__grid { grid-template-columns: 1fr; }
    .foot__cta, .foot__cta .btn { width: 100%; }
    .foot { padding-bottom: 5rem; }
  }
</style>
