---
/**
 * Apertura delle pagine di specializzazione: stessa famiglia per tutte, in tre varianti
 * (foto a destra su ghiaccio, foto a sinistra su bianco, foto larga al bordo su azzurro).
 * L'icona dell'area galleggia piano (ferma con riduzione del movimento).
 */
import Img from '../Img.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';

interface Props {
  crumbs: { label: string; href?: string }[];
  title: string; lead?: string; img?: string; alt?: string; icon: string;
  variant: 0 | 1 | 2; services: number; doctors: string[];
}
const { crumbs, title, lead, img, alt = '', icon, variant, services, doctors } = Astro.props;
---
<section class:list={['sh-hero', `sh-hero--v${variant}`]}>
  <div class="wrap sh-hero__grid">
    <div class="sh-hero__in">
      <nav class="sh-hero__crumbs" aria-label="Percorso">
        {crumbs.map((c, i) => (<>{i > 0 && <span aria-hidden="true">/</span>}{c.href ? <a href={c.href}>{c.label}</a> : <span aria-current="page">{c.label}</span>}</>))}
      </nav>
      <span class="sh-hero__ic" aria-hidden="true"><Icon name={icon} /></span>
      <h1 class="sh-hero__t" data-lines set:html={title} />
      {lead && <p class="sh-hero__lead" data-reveal set:html={lead} />}
      <div class="sh-hero__act" data-reveal>
        <a class="btn btn--green" href={site.doctolib.href} target="_blank" rel="noopener">Prenota una visita</a>
        <a class="btn btn--line" href={site.phone.href}><Icon name="phone" /> {site.phone.label}</a>
      </div>
      {(services > 0 || doctors.length > 0) && (
        <ul class="sh-hero__facts" role="list" data-reveal>
          {services > 0 && <li><Icon name="list-check" /><span><strong>{services}</strong> {services === 1 ? 'prestazione' : 'prestazioni'}</span></li>}
          {doctors.length > 0 && <li><Icon name="user-heart" /><span>{doctors.join(', ')}</span></li>}
        </ul>
      )}
    </div>
    {img && (
      <figure class="sh-hero__pic" data-img>
        <Img src={img} alt={alt} loading="eager" fetchpriority="high" sizes="(min-width: 900px) 50vw, 100vw" widths={[700, 1100, 1600]} />
      </figure>
    )}
  </div>
</section>

<style>
  .sh-hero { overflow: hidden; }
  .sh-hero__grid { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); align-items: center; gap: clamp(2rem, 5vw, 5rem); padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .sh-hero__in { display: grid; gap: 1.2rem; justify-items: start; }
  .sh-hero__crumbs { display: flex; flex-wrap: wrap; gap: 0.6rem; font-size: 0.85rem; color: var(--muted); }
  .sh-hero__crumbs a { color: inherit; text-decoration: none; }
  .sh-hero__crumbs a:hover { text-decoration: underline; }
  .sh-hero__ic { display: grid; place-items: center; width: 4rem; height: 4rem; border-radius: 50%; background: #fff; color: var(--green); box-shadow: 0 18px 40px -24px rgb(18 60 80 / 0.4); animation: sh-float 6s ease-in-out infinite; }
  .sh-hero__ic :global(.icon) { width: 1.8rem; height: 1.8rem; }
  @keyframes sh-float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  .sh-hero__t { max-width: 14ch; font-size: clamp(2.6rem, 1.4rem + 3.8vw, 5rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; color: var(--deep); }
  .sh-hero__lead { max-width: 46ch; font-size: 1.1rem; line-height: 1.6; color: var(--ink-2); }
  .sh-hero__act { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .sh-hero__act .btn--line { background: #fff; }
  .sh-hero__facts { list-style: none; display: grid; gap: 0.5rem; width: 100%; padding-top: 1.1rem; border-top: 1px solid var(--line-2); font-size: 0.95rem; color: var(--ink-2); }
  .sh-hero__facts li { display: flex; align-items: center; gap: 0.6rem; }
  .sh-hero__facts strong { font-weight: 600; color: var(--deep); }
  .sh-hero__facts :global(.icon) { flex: none; width: 1.15rem; height: 1.15rem; color: var(--green); }
  .sh-hero__pic { margin: 0; overflow: hidden; border-radius: var(--r); }
  .sh-hero__pic :global(picture), .sh-hero__pic :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* v0: ghiaccio, foto a destra alta */
  .sh-hero--v0 { background: var(--ice); }
  .sh-hero--v0 .sh-hero__pic { height: clamp(380px, 64vh, 620px); }
  /* v1: bianco, foto a sinistra su una lastra ghiaccio sfalsata */
  .sh-hero--v1 { background: #fff; }
  .sh-hero--v1 .sh-hero__ic { background: var(--ice); box-shadow: none; }
  .sh-hero--v1 .sh-hero__pic { order: -1; height: clamp(380px, 62vh, 600px); box-shadow: 1.6rem 1.6rem 0 var(--ice); }
  /* v2: azzurro chiaro, foto larga fino al bordo destro */
  .sh-hero--v2 { background: #e4eff2; }
  .sh-hero--v2 .sh-hero__grid { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); padding-block: 0; }
  .sh-hero--v2 .sh-hero__in { padding-block: clamp(2.5rem, 5vw, 4.5rem); }
  .sh-hero--v2 .sh-hero__pic { align-self: stretch; height: auto; min-height: clamp(420px, 66vh, 660px); margin-right: calc(-1 * max(var(--pad), (100vw - var(--max)) / 2)); border-radius: var(--r) 0 0 var(--r); }

  @media (max-width: 900px) {
    .sh-hero__grid, .sh-hero--v2 .sh-hero__grid { grid-template-columns: 1fr; }
    .sh-hero__pic, .sh-hero--v0 .sh-hero__pic, .sh-hero--v1 .sh-hero__pic { height: 44vh; order: 0; box-shadow: none; }
    .sh-hero--v2 .sh-hero__pic { min-height: 44vh; margin-right: 0; margin-bottom: 2rem; border-radius: var(--r); }
  }
  @media (max-width: 560px) { .sh-hero__act, .sh-hero__act .btn { width: 100%; } }
  @media (prefers-reduced-motion: reduce) { .sh-hero__ic { animation: none; } }
</style>
