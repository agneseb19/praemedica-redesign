---
/**
 * Contenuto delle pagine di specializzazione sotto l'apertura. Ordine fisso:
 * prestazioni → in breve → domande → specialisti. Cinque disposizioni (a rotazione),
 * ognuna con le prestazioni presentate in modo diverso. Testi essenziali: in vista il
 * primo paragrafo, il resto dietro "Leggi tutto". Nessuna foto enorme: sempre affiancate.
 */
import Img from '../Img.astro';
import Icon from '../Icon.astro';
import Blocks from '../Blocks.astro';
import TeamCards from '../TeamCards.astro';
import SectionHead from '../SectionHead.astro';
import ReadMore from './ReadMore.astro';
import type { Block, Person } from '../../lib/content';
import { site } from '../../data/site';

interface Pic { src: string; alt: string }
interface Q { id: string; titleHtml: string; short: string; restHtml: string; restBlocks: Block[]; images: Pic[] }
interface Services { id: string; titleHtml: string; items: string[]; book?: { href: string; text: string }; rest: Block[] }
interface Team { id: string; titleHtml: string; people?: Person[]; blocks: Block[] }
interface Props {
  recipe: 0 | 1 | 2 | 3 | 4;
  label: string;
  intro: { short: string; restHtml: string };
  photo?: Pic;
  questions: Q[];
  services: Services | null;
  team: Team[];
}
const { recipe, label, intro, photo, questions, services, team } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
const people = team.flatMap((t) => t.people ?? []);
const book = services?.book ?? { href: site.phone.href, text: 'Prenota ora' };
const lower = label.toLowerCase();
const gallery = questions.flatMap((q) => q.images);
let n = 0;
const next = () => pad(++n);
---
{/* ======================= PRESTAZIONI (sempre per prime, in 5 disposizioni) ======================= */}
{services && recipe === 0 && (
  <section id={services.id} class="sec" aria-labelledby="sv-t">
    <SectionHead n={next()} id="sv-t" title={services.titleHtml} />
    <div class="wrap">
      <ol class:list={['sv0', { 'sv0--few': services.items.length < 5 }]} role="list">{services.items.map((s, i) => <li data-reveal><span class="sv0__n">{pad(i + 1)}</span><span>{s}</span></li>)}</ol>
      {services.rest.length > 0 && <div class="col"><Blocks blocks={services.rest} /></div>}
      <p class="cta-row" data-reveal><a class="btn btn--green" href={book.href}><Icon name="phone" /> {book.text}</a></p>
    </div>
  </section>
)}
{services && recipe === 1 && (
  <section id={services.id} class="sv1" aria-labelledby="sv-t">
    <div class="wrap sv1__in">
      <div class="sv1__head">
        <span class="sv1__n">{next()}</span>
        <h2 id="sv-t" class="sv1__t" data-lines set:html={services.titleHtml} />
        <p class="sv1__d" data-reveal>{services.items.length} {services.items.length === 1 ? 'prestazione' : 'prestazioni'}, prenotabili online o al telefono.</p>
        <a class="btn btn--green" href={book.href} data-reveal><Icon name="phone" /> {book.text}</a>
      </div>
      <ul class="sv1__list" role="list">{services.items.map((s) => <li data-reveal><Icon name="check" /><span>{s}</span></li>)}</ul>
      {services.rest.length > 0 && <div class="sv1__rest"><Blocks blocks={services.rest} /></div>}
    </div>
  </section>
)}
{services && recipe === 2 && (
  <section id={services.id} class="sec" aria-labelledby="sv-t">
    <SectionHead n={next()} id="sv-t" title={services.titleHtml} />
    <div class="wrap">
      <div class="sv2" data-reveal>
        <ul class="sv2__chips" role="list">{services.items.map((s) => <li>{s}</li>)}</ul>
        {services.rest.length > 0 && <Blocks blocks={services.rest} />}
        <div class="sv2__foot">
          <span><Icon name="calendar-check" /> Prenota online su Doctolib o chiamaci</span>
          <a class="btn btn--green" href={book.href}><Icon name="phone" /> {book.text}</a>
        </div>
      </div>
    </div>
  </section>
)}
{services && recipe === 3 && (
  <section id={services.id} class="sec" aria-labelledby="sv-t">
    <SectionHead n={next()} id="sv-t" title={services.titleHtml} />
    <div class="wrap sv3">
      {photo && <figure class="sv3__pic" data-img><Img src={photo.src} alt={photo.alt} sizes="(min-width: 900px) 32vw, 92vw" widths={[500, 900]} /></figure>}
      <div class="sv3__card" data-reveal>
        <ul role="list">{services.items.map((s) => <li><Icon name="check" /><span>{s}</span></li>)}</ul>
        {services.rest.length > 0 && <Blocks blocks={services.rest} />}
        <div class="sv3__foot">
          <a class="btn btn--green" href={book.href}><Icon name="phone" /> {book.text}</a>
          {people.length > 0 && <p><Icon name="user-heart" /> {people.map((p) => p.name).join(', ')}</p>}
        </div>
      </div>
    </div>
  </section>
)}
{services && recipe === 4 && (
  <section id={services.id} class="sec" aria-labelledby="sv-t">
    <SectionHead n={next()} id="sv-t" title={services.titleHtml} />
    <div class="wrap">
      <ul class="sv4" role="list">{services.items.map((s) => <li data-reveal><span class="sv4__ic"><Icon name="stethoscope" /></span><span>{s}</span></li>)}</ul>
      {services.rest.length > 0 && <div class="col"><Blocks blocks={services.rest} /></div>}
      <p class="cta-row" data-reveal><a class="btn btn--green" href={book.href}><Icon name="phone" /> {book.text}</a></p>
    </div>
  </section>
)}

{/* ======================= IN BREVE: una frase essenziale, centrata, senza foto accanto ======================= */}
{intro.short && recipe !== 2 && (
  <section class="sec" aria-labelledby="in-t">
    <div class="wrap">
      <div class="in" data-reveal>
        <span class="in__n">{next()}</span>
        <h2 id="in-t" class="in__t">In breve</h2>
        <p class="in__lead" set:html={intro.short} />
        <ReadMore html={intro.restHtml} blocks={photo && recipe !== 3 ? [{ type: 'image', src: photo.src, alt: photo.alt } as Block] : []} />
      </div>
    </div>
  </section>
)}

{/* ======================= DOMANDE (5 disposizioni) ======================= */}
{questions.length > 0 && recipe === 0 && (
  <section class="sec" aria-labelledby="q-t">
    <SectionHead n={next()} id="q-t" title="Domande frequenti" />
    <div class="wrap q0">
      {questions.map((q) => (
        <article id={q.id} class="q0__c" data-reveal>
          <h3 class="q-h" set:html={q.titleHtml} />
          <div class="prose" set:html={q.short} />
          <ReadMore html={q.restHtml} blocks={q.restBlocks} />
        </article>
      ))}
    </div>
  </section>
)}
{questions.length > 0 && recipe === 1 && (
  <section class="sec" aria-labelledby="q-t">
    <SectionHead n={next()} id="q-t" title="Da conoscere" />
    <div class="wrap q1">
      {questions.map((q) => (
        <article id={q.id} class="q1__row">
          <h3 class="q-h q1__t" data-reveal set:html={q.titleHtml} />
          <div data-reveal>
            <div class="prose" set:html={q.short} />
            <ReadMore html={q.restHtml} blocks={q.restBlocks} />
          </div>
        </article>
      ))}
    </div>
  </section>
)}
{(questions.length > 0 || intro.short) && recipe === 2 && (
  <section class="sec" aria-labelledby="q-t">
    <SectionHead n={next()} id="q-t" title="Passo dopo passo" desc={`Quello che serve sapere sulla ${lower}, nell'ordine giusto.`} />
    <div class="wrap q2">
      {photo && <figure class="q2__pic" data-img><Img src={photo.src} alt={photo.alt} sizes="(min-width: 900px) 34vw, 92vw" widths={[500, 900]} /></figure>}
      <ol class="q2__steps" role="list">
        {intro.short && <li data-reveal><span class="q2__dot">1</span><div><h3 class="q-h">In breve</h3><div class="prose" set:html={intro.short} /><ReadMore html={intro.restHtml} /></div></li>}
        {questions.map((q, i) => (
          <li id={q.id} data-reveal><span class="q2__dot">{i + (intro.short ? 2 : 1)}</span><div>
            <h3 class="q-h" set:html={q.titleHtml} />
            <div class="prose" set:html={q.short} />
            <ReadMore html={q.restHtml} blocks={q.restBlocks} />
          </div></li>
        ))}
      </ol>
    </div>
  </section>
)}
{questions.length > 0 && recipe === 3 && (
  <section class="sec" aria-labelledby="q-t">
    <SectionHead n={next()} id="q-t" title="Le domande più comuni" />
    <div class="wrap q3" style={`--cols:${questions.length % 3 === 0 ? 3 : questions.length % 2 === 0 ? 2 : Math.min(questions.length, 3)}`}>
      {questions.map((q, i) => (
        <article id={q.id} class="q3__c" data-reveal>
          <span class="q3__n">{pad(i + 1)}</span>
          <div>
            <h3 class="q-h" set:html={q.titleHtml} />
            <div class="prose" set:html={q.short} />
            <ReadMore html={q.restHtml} blocks={q.restBlocks} />
          </div>
        </article>
      ))}
    </div>
  </section>
)}
{questions.length > 0 && recipe === 4 && (
  <section class="sec" aria-labelledby="q-t">
    <SectionHead n={next()} id="q-t" title="Le risposte dello specialista" />
    <div class="wrap q4">
      {questions.map((q, i) => (
        <article id={q.id} class="q4__c" data-reveal>
          <span class="q4__n">{pad(i + 1)}</span>
          <h3 class="q-h" set:html={q.titleHtml} />
          <div class="prose" set:html={q.short} />
          <ReadMore html={q.restHtml} blocks={q.restBlocks} />
        </article>
      ))}
    </div>
  </section>
)}

{/* foto delle domande: una fila larga sotto, mai foto enormi né colonne strette */}
{gallery.length > 0 && (
  <div class="wrap gal" style={`--g:${Math.min(gallery.length, 3)}`}>
    {gallery.map((im) => <figure data-img><Img src={im.src} alt={im.alt} sizes="(min-width: 900px) 33vw, 92vw" widths={[500, 900, 1300]} /></figure>)}
  </div>
)}

{/* ======================= SPECIALISTI ======================= */}
{team.map((t) => (
  <section id={t.id} class="sec" aria-label={t.titleHtml.replace(/<[^>]+>/g, '')}>
    <SectionHead n={next()} title={t.titleHtml} />
    <div class="wrap">{t.people ? <TeamCards people={t.people} /> : <Blocks blocks={t.blocks} />}</div>
  </section>
))}

<style>
  .cta-row { display: flex; justify-content: center; margin-top: clamp(1.8rem, 3vw, 2.6rem); }
  .q-h { font-size: var(--t-h3); font-weight: 500; line-height: 1.2; letter-spacing: -0.025em; color: var(--deep); }
  .gal { display: grid; grid-template-columns: repeat(var(--g), minmax(0, 1fr)); gap: 1rem; margin-top: calc(-1 * clamp(1rem, 2vw, 2rem)); padding-bottom: clamp(3.5rem, 2.5rem + 3.5vw, 6.5rem); }
  .gal figure { margin: 0; aspect-ratio: 16 / 9; overflow: hidden; border-radius: var(--r); }
  .gal :global(picture), .gal :global(img) { width: 100%; height: 100%; object-fit: cover; }

  /* prestazioni 0: righe numerate in due colonne */
  .sv0 { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 2.5rem; border-top: 1px solid var(--line); }
  .sv0 li { display: flex; align-items: center; gap: 1.2rem; padding: 1.15rem 0; border-bottom: 1px solid var(--line); font-size: 1.08rem; font-weight: 500; color: var(--deep); }
  .sv0--few { max-width: 860px; margin-inline: auto; }
  .sv0__n { flex: none; font-size: 0.85rem; color: var(--green); font-variant-numeric: tabular-nums; }
  /* prestazioni 1: fascia blu */
  .sv1 { padding-block: clamp(3.5rem, 2.5rem + 3.5vw, 6.5rem); background: var(--deep); color: #fff; }
  .sv1 + :global(.sec) { padding-top: clamp(3.5rem, 2.5rem + 3.5vw, 6.5rem); }
  .sv1__in { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .sv1__head { display: grid; gap: 1.1rem; justify-items: start; }
  .sv1__n { font-size: 0.85rem; color: #8fd69a; }
  .sv1__t { font-size: var(--t-h2); font-weight: 500; line-height: 1.05; letter-spacing: -0.045em; color: #fff; }
  .sv1__d { font-size: 1.02rem; line-height: 1.6; color: rgb(255 255 255 / 0.8); }
  .sv1__list { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.6rem; }
  .sv1__list li { display: flex; align-items: center; gap: 0.8rem; padding: 1rem 1.2rem; background: rgb(255 255 255 / 0.07); border: 1px solid rgb(255 255 255 / 0.12); border-radius: 14px; font-size: 1.02rem; }
  .sv1__list :global(.icon) { flex: none; width: 1.1rem; height: 1.1rem; color: #8fd69a; }
  .sv1__rest { grid-column: 2; color: rgb(255 255 255 / 0.85); }
  /* prestazioni 2: una scheda con le voci a pastiglia */
  .sv2 { display: grid; gap: 1.6rem; max-width: 980px; margin-inline: auto; padding: clamp(1.6rem, 3vw, 2.6rem); background: #fff; border: 1px solid var(--line-2); border-radius: var(--r); box-shadow: 0 30px 60px -45px rgb(18 60 80 / 0.4); }
  .sv2__chips { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.6rem; }
  .sv2__chips li { padding: 0.8rem 1.2rem; background: var(--ice); border-radius: 999px; font-size: 1.02rem; font-weight: 500; color: var(--deep); }
  .sv2__foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 1.4rem; border-top: 1px solid var(--line); font-size: 0.98rem; color: var(--ink-2); }
  .sv2__foot span { display: inline-flex; align-items: center; gap: 0.5rem; }
  .sv2__foot :global(.icon) { width: 1.2rem; height: 1.2rem; color: var(--green); }
  /* prestazioni 3: foto e scheda affiancate */
  .sv3 { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 3.5rem); align-items: stretch; }
  .sv3__pic { margin: 0; min-height: 320px; overflow: hidden; border-radius: var(--r); }
  .sv3__pic :global(picture), .sv3__pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .sv3__card { display: grid; align-content: center; gap: 1.2rem; padding: clamp(1.6rem, 3vw, 2.6rem); background: var(--ice); border-radius: var(--r); }
  .sv3__card ul { list-style: none; display: grid; }
  .sv3__card li { display: flex; align-items: center; gap: 0.7rem; padding: 0.85rem 0; border-bottom: 1px solid var(--line-2); font-size: 1.05rem; font-weight: 500; color: var(--deep); }
  .sv3__card :global(.icon) { flex: none; width: 1.1rem; height: 1.1rem; color: var(--green); }
  .sv3__foot { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  .sv3__foot p { display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; color: var(--ink-2); }
  /* prestazioni 4: schede con icona */
  .sv4 { list-style: none; display: flex; flex-wrap: wrap; justify-content: center; gap: 0.9rem; }
  .sv4 li { flex: 0 1 260px; }
  .sv4 li { display: grid; align-content: start; gap: 0.9rem; min-height: 140px; padding: 1.4rem; background: #fff; border: 1px solid var(--line-2); border-radius: 20px; font-size: 1.06rem; font-weight: 500; color: var(--deep); transition: border-color 0.3s, transform 0.4s var(--ease); }
  .sv4 li:hover { border-color: var(--green); transform: translateY(-3px); }
  .sv4__ic { display: grid; place-items: center; width: 2.8rem; height: 2.8rem; border-radius: 50%; background: var(--ice); color: var(--green); }
  .sv4__ic :global(.icon) { width: 1.3rem; height: 1.3rem; }

  /* in breve: frase centrata su ghiaccio */
  .in { display: grid; justify-items: center; gap: 1rem; max-width: 980px; margin-inline: auto; padding: clamp(2.2rem, 4vw, 3.5rem) clamp(1.5rem, 5vw, 4.5rem); background: var(--ice); border-radius: var(--r); text-align: center; }
  .in__n { font-size: 0.85rem; color: var(--green); font-variant-numeric: tabular-nums; }
  .in__t { font-size: 1rem; font-weight: 500; letter-spacing: 0.02em; color: var(--blue); }
  .in__lead { max-width: 40ch; font-size: clamp(1.3rem, 1.1rem + 0.8vw, 1.8rem); line-height: 1.45; letter-spacing: -0.02em; color: var(--deep); }
  .in__lead :global(strong) { font-weight: 600; }
  .in :global(.rm) { text-align: left; width: 100%; }
  .in :global(.rm summary) { display: flex; justify-content: center; }

  /* domande 0: schede ghiaccio */
  .q0 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 1rem; }
  .q0__c { display: grid; align-content: start; gap: 0.9rem; padding: clamp(1.6rem, 3vw, 2.4rem); background: var(--ice); border-radius: var(--r); }
  /* domande 1: righe, domanda a sinistra */
  .q1__row { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(1.5rem, 4vw, 4rem); padding-block: clamp(1.8rem, 3vw, 2.6rem); border-top: 1px solid var(--line); }
  .q1__row:last-child { border-bottom: 1px solid var(--line); }
  .q1__t { font-size: clamp(1.4rem, 1.15rem + 0.9vw, 1.9rem); letter-spacing: -0.035em; }
  /* domande 2: percorso */
  .q2 { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .q2__pic { position: sticky; top: 110px; margin: 0; aspect-ratio: 3 / 4; max-height: 560px; overflow: hidden; border-radius: var(--r); }
  .q2__pic :global(picture), .q2__pic :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .q2__steps { list-style: none; position: relative; display: grid; gap: clamp(1.8rem, 3vw, 2.6rem); }
  .q2__steps::before { content: ''; position: absolute; left: 1.5rem; top: 1.5rem; bottom: 1.5rem; width: 2px; background: linear-gradient(var(--green), var(--azure)); }
  .q2__steps > li { position: relative; display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: 1.4rem; }
  .q2__steps .q-h { margin-bottom: 0.7rem; padding-top: 0.55rem; }
  .q2__dot { position: relative; z-index: 1; display: grid; place-items: center; width: 3rem; height: 3rem; border-radius: 50%; background: var(--deep); color: #fff; font-weight: 600; box-shadow: 0 0 0 6px #fff; }
  /* domande 3: elenco numerato su due colonne */
  .q3 { display: grid; grid-template-columns: repeat(var(--cols, 2), minmax(0, 1fr)); gap: 0 clamp(2rem, 5vw, 4rem); }
  .q3__c { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1.2rem; padding-block: 1.8rem; border-top: 2px solid var(--deep); }
  .q3__c .q-h { margin-bottom: 0.7rem; }
  .q3__n { font-size: 0.9rem; font-weight: 600; color: var(--green); font-variant-numeric: tabular-nums; }
  /* domande 4: colonne aperte con numero grande */
  .q4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: clamp(2rem, 5vw, 4.5rem); }
  .q4__c { display: grid; align-content: start; gap: 0.8rem; }
  .q4__n { font-size: clamp(2.4rem, 1.8rem + 1.8vw, 3.4rem); font-weight: 500; line-height: 1; letter-spacing: -0.05em; color: var(--azure); }

  @media (max-width: 900px) {
    .sv1__in, .sv3, .q1__row, .q2, .q3 { grid-template-columns: 1fr; }
    .sv1__rest { grid-column: 1; }
    .q2__pic { position: static; aspect-ratio: 4 / 3; }
  }
  @media (max-width: 640px) {
    .sv0, .sv1__list, .gal { grid-template-columns: 1fr; }
    .sv4 li { min-height: 0; }
    .sv2__foot { justify-content: center; text-align: center; }
  }
  @media (prefers-reduced-motion: reduce) { .sv4 li:hover { transform: none; } }
</style>
