---
/** Il resto di un testo originale, chiuso dietro "Leggi tutto": niente viene tolto, si legge solo se serve. */
import Icon from '../Icon.astro';
import Blocks from '../Blocks.astro';
import type { Block } from '../../lib/content';
interface Props { html?: string; blocks?: Block[] }
const { html = '', blocks = [] } = Astro.props;
const has = html.trim().length > 0 || blocks.length > 0;
---
{has && (
  <details class="rm">
    <summary><span>Leggi tutto</span><Icon name="chevron-down" /></summary>
    <div class="prose rm__body">
      {html && <Fragment set:html={html} />}
      {blocks.length > 0 && <Blocks blocks={blocks} />}
    </div>
  </details>
)}

<style>
  .rm { margin-top: 0.9rem; }
  .rm summary { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; font-size: 0.98rem; font-weight: 500; color: var(--green-ink); cursor: pointer; list-style: none; }
  .rm summary::-webkit-details-marker { display: none; }
  .rm summary :global(.icon) { width: 1.05rem; height: 1.05rem; transition: transform 0.35s var(--ease); }
  .rm[open] summary :global(.icon) { transform: rotate(180deg); }
  .rm[open] summary span { font-size: 0; }
  .rm[open] summary span::after { content: 'Chiudi'; font-size: 0.98rem; }
  .rm__body { margin-top: 0.6rem; }
</style>
